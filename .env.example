# ---------------------------------------------------------------------------
# Docker / PostgreSQL service credentials
# These values configure both the postgres container and the Laravel app
# connection. All three must match. Never commit real passwords here.
# ---------------------------------------------------------------------------
POSTGRES_DB=procynia
POSTGRES_USER=change_me
POSTGRES_PASSWORD=change_me

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Produksjon: APP_URL=https://<domene> — f.eks. APP_URL=https://app.procynia.no
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Laravel database connection — set to match POSTGRES_* above.
# Procynia local development uses Docker Postgres only.
# Host access, including pgAdmin, must use 127.0.0.1:5433.
# Do not point Procynia at localhost:5432.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=procynia
DB_USERNAME=change_me
DB_PASSWORD=change_me

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# SESSION_SECURE_COOKIE is deliberately not set here (security finding F-06).
# config/session.php defaults it to true whenever APP_ENV is anything but local, so a
# production deploy gets a Secure session cookie without anyone remembering to set it.
# Setting it to true in this file would break local http://localhost development, since
# this example ships with APP_ENV=local. Only set it explicitly to override the default —
# see docs/operations/security.md.

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Inside Docker Compose the queue and cache backends are Redis.
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# Redis holds sessions, queues and cache in Procynia, so it is authenticated (security
# finding F-08). REDIS_PASSWORD is required: docker-compose starts Redis with
# --requirepass from this value and refuses to start if it is empty, and Laravel sends the
# same value on every connection. Generate one per environment, e.g.:
#
#   openssl rand -base64 32
#
# Never commit a real value. In production it belongs in the server's .env, not here.
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

DOFFIN_SCHEDULED_IMPORT_ENABLED=false
DOFFIN_WATCH_INBOX_DISCOVERY_ENABLED=false
DOFFIN_API_KEY=
# Produksjon skal alltid bruke live API. Lokal utvikling kan bruke https://betaapi.doffin.no – men bare ved eksplisitt bevisst valg.
DOFFIN_BASE_URL=https://api.doffin.no
DOFFIN_SEARCH_ENDPOINT=/public/v2/search
DOFFIN_DOWNLOAD_ENDPOINT=/public/v2/download
DOFFIN_USER_AGENT=Procynia/1.0
DOFFIN_TIMEOUT=30
DOFFIN_CONNECT_TIMEOUT=10
DOFFIN_BATCH_LIMIT=10

# Docker/produksjon: /usr/bin/pdftotext (poppler-utils installert i Dockerfile)
# Lokal Mac (Homebrew): /opt/homebrew/bin/pdftotext
PDFTOTEXT_BINARY=/usr/bin/pdftotext

# Docker/produksjon: /usr/bin/pdftohtml (poppler-utils installert i Dockerfile)
# Lokal Mac (Homebrew): /opt/homebrew/bin/pdftohtml
PDFTOHTML_BINARY=/usr/bin/pdftohtml

# Docker/produksjon: /usr/bin/pdfimages (poppler-utils installert i Dockerfile)
# Lokal Mac (Homebrew): /opt/homebrew/bin/pdfimages
PDFIMAGES_BINARY=/usr/bin/pdfimages

# Docker/produksjon: /usr/bin/pdfinfo (poppler-utils installert i Dockerfile)
# Lokal Mac (Homebrew): /opt/homebrew/bin/pdfinfo
PDFINFO_BINARY=/usr/bin/pdfinfo

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Enterprise Wiki AI generation. Set to true only after Phase 1F-B manual verification.
ENTERPRISE_WIKI_AI_ENABLED=false
# v0.10: run-wide ceiling on new claims one applied run's extraction may persist (never fails the run).
ENTERPRISE_WIKI_MAX_NEW_CLAIMS_PER_RUN=60

# AI usage tempo controls. Procynia now uses these for internal warning signals and reporting, not for stopping AI calls.
AI_RATE_LIMIT_USER_PER_MINUTE=5
# Deprecated: customer-hour throttling is no longer used as a stop mechanism.
AI_RATE_LIMIT_CUSTOMER_PER_HOUR=50
AI_RATE_LIMIT_USER_DECAY_SECONDS=60
AI_RATE_LIMIT_CUSTOMER_DECAY_SECONDS=3600

STRIPE_KEY=pk_test_
STRIPE_SECRET=sk_test_
# Signeringshemmeligheten Stripe oppgir for webhook-endepunktet.
#
# Bevisst tom. Plassholderen «whsec_» var ikke tom, og fikk derfor konfigurasjonen til å se komplett
# ut samtidig som hver ekte webhook ble avvist med 403 «ugyldig signatur» — en feilmelding som peker
# feil vei. Tom verdi gir i stedet 503 «ikke konfigurert», som sier hva som faktisk mangler.
#
# Påkrevd i produksjon dersom Stripe/fakturering er i bruk. Uten den avviser webhook-endepunktet alt.
# Ikke nødvendig i miljøer der Stripe ikke er aktivert — da mottar endepunktet uansett ingen kall.
STRIPE_WEBHOOK_SECRET=
CASHIER_CURRENCY=nok
CASHIER_CURRENCY_LOCALE=nb_NO
STRIPE_PRICE_PRO_MONTHLY=price_
STRIPE_PRICE_PRO_YEARLY=price_
STRIPE_PRICE_MAX_MONTHLY=price_
STRIPE_PRICE_MAX_YEARLY=price_
STRIPE_PRICE_ULTRA_MONTHLY=price_
STRIPE_PRICE_ULTRA_YEARLY=price_

# Proxyer hvis X-Forwarded-*-headere Laravel skal stole på. Kommaseparert IP eller CIDR.
#
# Tom = stol på ingen. Klient-IP hentes da fra REMOTE_ADDR, altså peer-en nginx faktisk tok imot
# forbindelsen fra, som en klient ikke kan forfalske. Dette er riktig verdi for lokal utvikling.
#
# On-prem produksjon MÅ sette denne til adressen den ytre reverse proxyen har sett fra containeren
# (Docker-gatewayen). Uten den ser Laravel ikke ekte klient-IP, og HTTPS-gjenkjenning fra
# X-Forwarded-Proto slutter å virke. Se docs/operations/production-deploy.md.
#
# Azure: settes til Container Apps ingress-området når det er verifisert. Ikke gjett.
#
# Sett aldri "*" — det var nettopp den innstillingen som gjorde klient-IP forfalskbar.
TRUSTED_PROXIES=

# Legacy Compose-backup (scripts/backup-production.sh → `docker compose exec -T postgres pg_dump`).
# true i Docker Compose-miljøer som faktisk har Docker. Azure Container Apps setter denne til false
# via infra/main.bicep; der gjelder Azure PostgreSQL automatisk backup og point-in-time restore.
# Dette er ikke det samme som backup_settings.backup_enabled i databasen — den sier om en operatør
# har slått backup på, denne sier om runtime i det hele tatt kan kjøre mekanismen.
PROCYNIA_LEGACY_BACKUP_ENABLED=true

UPTIME_KUMA_URL=http://127.0.0.1:3001
PROCYNIA_HEALTH_TOKEN=
