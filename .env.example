# ---------------------------------------------------------------------------
# Docker / PostgreSQL service credentials
# These values configure both the postgres container and the Laravel app
# connection. All three must match. Never commit real passwords here.
# ---------------------------------------------------------------------------
POSTGRES_DB=procynia
POSTGRES_USER=change_me
POSTGRES_PASSWORD=change_me

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Laravel database connection — set to match POSTGRES_* above.
# Inside Docker Compose, DB_HOST must be "postgres" (the service name).
# From the host (e.g. pgAdmin), connect to 127.0.0.1:5433 instead.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=procynia
DB_USERNAME=change_me
DB_PASSWORD=change_me

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Inside Docker Compose the queue and cache backends are Redis.
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
# Inside Docker Compose, REDIS_HOST must be "redis" (the service name).
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

DOFFIN_API_KEY=
DOFFIN_BASE_URL=https://betaapi.doffin.no
DOFFIN_SEARCH_ENDPOINT=/public/v2/search
DOFFIN_DOWNLOAD_ENDPOINT=/public/v2/download
DOFFIN_USER_AGENT=Procynia/1.0
DOFFIN_TIMEOUT=30
DOFFIN_BATCH_LIMIT=10

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

STRIPE_KEY=pk_test_
STRIPE_SECRET=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
CASHIER_CURRENCY=nok
CASHIER_CURRENCY_LOCALE=nb_NO
STRIPE_PRICE_PRO_MONTHLY=price_
STRIPE_PRICE_PRO_YEARLY=price_
STRIPE_PRICE_MAX_MONTHLY=price_
STRIPE_PRICE_MAX_YEARLY=price_
STRIPE_PRICE_ULTRA_MONTHLY=price_
STRIPE_PRICE_ULTRA_YEARLY=price_

UPTIME_KUMA_URL=http://127.0.0.1:3001
PROCYNIA_HEALTH_TOKEN=
