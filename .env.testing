APP_ENV=testing
APP_KEY=base64:YWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWE=
APP_CONFIG_CACHE=bootstrap/cache/testing-config.php
APP_SERVICES_CACHE=bootstrap/cache/testing-services.php
APP_PACKAGES_CACHE=bootstrap/cache/testing-packages.php
APP_ROUTES_CACHE=bootstrap/cache/testing-routes.php
APP_EVENTS_CACHE=bootstrap/cache/testing-events.php

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=4
BROADCAST_CONNECTION=null
CACHE_STORE=array
MAIL_MAILER=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
PULSE_ENABLED=false
TELESCOPE_ENABLED=false
NIGHTWATCH_ENABLED=false

# Doffin's authenticated API host. Deliberately has no default in config/doffin.php
# (c46ee6f, AVVIK-008): base_url is paired with DOFFIN_API_KEY, and
# DoffinImportControlService::hasRequiredApiConfiguration() requires BOTH before any import runs,
# so a baked-in default would turn a fail-closed guard into a silent opt-in. The public host is
# the same value .env.example documents and is not a secret. DOFFIN_API_KEY stays unset here, so
# the guard is still closed and no Doffin call can be attempted from the test suite.
DOFFIN_BASE_URL=https://api.doffin.no

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=procynia_test
# Local-only role: full rights on procynia_test, no CONNECT on procynia.
# Single source of truth for the suite is Tests\TestCase::TEST_DATABASE_CREDENTIALS.
DB_USERNAME=procynia_test_user
DB_PASSWORD=test_only_local_9f3a1c
